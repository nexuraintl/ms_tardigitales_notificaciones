APP_NAME=jcc-notifications-api
APP_ENV=development
APP_PORT=8000

# Conexión al Gestor de Base de Datos Central (gestion_bdconex)
# Para contenedores Docker, usamos host.docker.internal para conectar al host de Laragon
DB1_HOST=host.docker.internal
DB1_PORT=3306
DB1_USER=root
DB1_PASS=
DB1_NAME=pre_gestion_bdconex

# ID de Cliente específico de JCC Tarjeta Digital en tn_gestion_bdconex
CLIENT_ID=20002

# Conexión Local de Respaldo (Fallback local en Laragon)
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=producto9_base

LOG_LEVEL=INFO
